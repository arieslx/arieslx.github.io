<% var projects = site.data.portfolio || [] %>
<% var categories = [] %>
<% projects.forEach(function(project) { %>
  <% if (!categories.some(function(category) { return category.slug === project.category.slug })) { %>
    <% categories.push(project.category) %>
  <% } %>
<% }) %>

<section id="about" class="portfolio-intro" aria-labelledby="portfolio-intro-title">
  <p class="portfolio-eyebrow">Hello / 你好</p>
  <h2 id="portfolio-intro-title">I'm LiuS, known as @Arieslx on the web.</h2>
  <p class="portfolio-intro-zh">我是 LiuS，在网络上使用 @Arieslx，是一名前端开发者。</p>
  <p class="portfolio-intro-en">I'm a front-end developer building thoughtful digital experiences.</p>
  <% if (theme.social_links) { %>
    <div class="portfolio-social" aria-label="Social links">
      <% for (var link in theme.social_links) { %>
        <% if (link === 'mail') { %>
          <a class="icon" target="_blank" rel="noopener noreferrer" href="<%- theme.social_links[link] %>" aria-label="Email">
            <i class="fas fa-envelope" aria-hidden="true"></i>
          </a>
        <% } else { %>
          <a class="icon" target="_blank" rel="noopener noreferrer" href="<%- url_for(theme.social_links[link]) %>" aria-label="<%= link %>">
            <i class="fab fa-<%= link %>" aria-hidden="true"></i>
          </a>
        <% } %>
      <% } %>
    </div>
  <% } %>
</section>

<section id="projects" class="portfolio" aria-labelledby="portfolio-title">
  <div class="portfolio-heading">
    <div>
      <p class="portfolio-eyebrow">Selected Work</p>
      <h2 id="portfolio-title">作品 / Projects</h2>
    </div>
    <p><%= projects.length %> project<%= projects.length === 1 ? '' : 's' %></p>
  </div>

  <div class="portfolio-filters" role="group" aria-label="作品分类 / Project categories">
    <button class="portfolio-filter is-active" type="button" data-filter="all" aria-pressed="true">全部 / All</button>
    <% categories.forEach(function(category) { %>
      <button class="portfolio-filter" type="button" data-filter="<%= category.slug %>" aria-pressed="false"><%= category.zh %> / <%= category.en %></button>
    <% }) %>
  </div>

  <div class="portfolio-grid<%= projects.length === 1 ? ' is-single' : '' %>" aria-live="polite">
    <% projects.forEach(function(project) { %>
      <article class="portfolio-card" data-category="<%= project.category.slug %>">
        <a class="portfolio-card-link" href="<%= project.url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= project.title.zh %> / <%= project.title.en %> on <%= project.platform %>">
          <img class="portfolio-cover" src="<%- url_for(project.cover) %>" width="804" height="772" loading="lazy" alt="<%= project.title.zh %> / <%= project.title.en %>">
          <div class="portfolio-card-body">
            <div class="portfolio-card-meta">
              <span><%= project.category.zh %> / <%= project.category.en %></span>
              <time datetime="<%= project.date %>"><%= project.date %></time>
            </div>
            <h3><%= project.title.zh %></h3>
            <p class="portfolio-card-title-en"><%= project.title.en %></p>
            <p><%= project.description.zh %></p>
            <p class="portfolio-card-description-en"><%= project.description.en %></p>
            <ul class="portfolio-tags" aria-label="Tags">
              <% project.tags.forEach(function(tag) { %>
                <li><%= tag %></li>
              <% }) %>
            </ul>
            <span class="portfolio-platform"><%= project.platform %> <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      </article>
    <% }) %>
  </div>
</section>

<section id="writing" class="portfolio-writing">
  <p class="portfolio-eyebrow">Writing</p>
  <a class="portfolio-articles-link" href="<%- url_for('archives') %>">文章 / Articles <span aria-hidden="true">→</span></a>
</section>
